{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "sahalink",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--host", "127.0.0.1", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "sahalink-test",
      "runtimeExecutable": "powershell",
      "runtimeArgs": ["-NoProfile", "-Command", "Remove-Item \"$env:TEMP\\sahalink-preview.db\" -ErrorAction SilentlyContinue; $env:SAHALINK_DB_PATH = \"$env:TEMP\\sahalink-preview.db\"; python -m uvicorn app.main:app --host 127.0.0.1 --port 8011"],
      "port": 8011
    }
  ]
}
